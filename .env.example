# =============================================================================
# NSE FastAPI — Environment Variables Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Existing NSE exchange credentials — DO NOT CHANGE these variable names
# -----------------------------------------------------------------------------
NSE_LOGIN_USER_ID=<your_nse_login_user_id>
NSE_API_SECRET=<your_nse_api_secret>
NSE_API_LICENSE_KEY=<your_nse_license_key>
NSE_MEMBER_CODE=<your_nse_member_code>
NSE_MEMBER_ID=<your_nse_member_id>
NSE_BASE_URL=https://nseinvestuat.nseindia.com
NSE_PROXY=

# -----------------------------------------------------------------------------
# Existing shared application auth — DO NOT CHANGE these variable names
# -----------------------------------------------------------------------------
APP_USERNAME=<shared_app_username>
APP_PASSWORD=<shared_app_password>

# Existing JWT secret for shared application Bearer tokens.
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=<generate_with_openssl_rand_hex_32>
JWT_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# Existing database config — DO NOT CHANGE these variable names
# -----------------------------------------------------------------------------
DB_USER=<db_user>
DB_PASSWORD=<db_password>
DB_HOST=<db_host>
DB_PORT=5432
DB_NAME=<db_name>
DB_SSL=false
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@<db_host>:5432/<db_name>

# Browser CORS origins (separate from the SSO endpoint origin allowlist).
ALLOWED_ORIGINS=https://lendrixventech.com,https://mutualfund.lendrixventech.com,https://nse.lendrixventech.com

# -----------------------------------------------------------------------------
# NEW — SSO-specific settings
# These are SEPARATE from all existing settings above.
# -----------------------------------------------------------------------------

# Full URL of the Lendrix Node.js one-time code verification endpoint.
# This endpoint is called server-to-server — never from the browser.
# Example: https://registration.lendrixventech.com/auth/sso/verify-code
LENDRIX_SSO_VERIFY_URL=https://registration.lendrixventech.com/auth/sso/verify-code

# Shared secret sent as Authorization: Bearer <secret> for server-to-server calls.
# Must match SSO_NSE_SERVICE_SECRET in the Lendrix Node.js backend.
# Must be at least 32 characters. Generate with: openssl rand -hex 32
# NEVER share this value with the browser or frontend.
LENDRIX_SSO_SERVER_SECRET=<generate_with_openssl_rand_hex_32>

# Separate JWT secret for customer SSO session tokens.
# MUST be different from JWT_SECRET above.
# Generate with: openssl rand -hex 32
SSO_JWT_SECRET=<generate_with_openssl_rand_hex_32_different_from_JWT_SECRET>

# Customer SSO session lifetime in minutes.
SSO_SESSION_EXPIRE_MINUTES=60

# Enable only after applying the reviewed SSO migrations required by enabled routes.
SSO_ENABLED=false
SSO_COOKIE_NAME=__Host-nse_sso_session
# Exact HTTPS frontend origins; configure localhost only in a separate HTTPS dev environment.
SSO_ALLOWED_ORIGINS=https://lendrixventech.com,https://mutualfund.lendrixventech.com
